FROM alpine:3.20
ARG TARGETARCH
LABEL org.opencontainers.image.title="XBnpp" \
      org.opencontainers.image.source="https://github.com/kele812/XBnpp" \
      org.opencontainers.image.licenses="MPL-2.0"
RUN apk add --no-cache ca-certificates tzdata && mkdir -p /etc/XBnpp
COPY --chmod=755 dist/XBnpp-linux-${TARGETARCH} /usr/local/bin/XBnpp
WORKDIR /etc/XBnpp
ENTRYPOINT ["XBnpp"]
CMD ["-c", "/etc/XBnpp/config.yml"]
